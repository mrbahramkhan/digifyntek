NODE_ENV=production
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=digi
DB_PASSWORD=change_me
DB_NAME=digifyntek
DB_MODE=native
JWT_SECRET=change_me_to_at_least_32_characters_long
JWT_EXPIRES=8h
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
TRUST_PROXY=0

# Product packs: core,kisaan,islamic,fmfb
PRODUCT_PACKS=conventional,islamic,agri,fmfb

# NADRA (mandatory for KYC in production)
# NADRA_MODE=simulator|live
NADRA_MODE=simulator
# NADRA_API_URL=
# NADRA_API_KEY=
# NADRA_CLIENT_ID=
# NADRA_MANDATORY=1

# MFA for admin roles (TOTP)
MFA_ENFORCE_ADMIN=1
MFA_ISSUER=DigiFyntek

# --- NADRA (identity verification) ---
# simulator | live
NADRA_MODE=simulator
# Live gateway base URL (bank middleware / licensed channel — not public NADRA)
# NADRA_API_URL=https://nadra-gateway.yourbank.local
# NADRA_API_KEY=
# NADRA_CLIENT_ID=
# NADRA_CLIENT_SECRET=
# NADRA_FRANCHISE_ID=
# NADRA_BRANCH_CODE=001
NADRA_BIOMETRIC=1
NADRA_TIMEOUT_MS=20000
# NADRA_VERIFY_PATH=/verisys/verify
# NADRA_BIO_PATH=/bio-verisys/verify
# NADRA_AUTH_HEADER=Bearer
# NADRA_ALLOW_VERISYS=0
# NADRA_BIO_TYPE=FINGERPRINT
NADRA_MANDATORY=1
