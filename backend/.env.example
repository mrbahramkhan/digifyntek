NODE_ENV=production
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=digi
DB_PASSWORD=change_me
DB_NAME=digifyntek
DB_MODE=native
JWT_SECRET=change_me_to_at_least_32_characters_long
JWT_EXPIRES=8h
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
TRUST_PROXY=0

# Product packs: core,kisaan,islamic,fmfb
PRODUCT_PACKS=conventional,islamic,agri,fmfb

# NADRA (mandatory for KYC in production)
# NADRA_MODE=simulator|live
NADRA_MODE=simulator
# NADRA_API_URL=
# NADRA_API_KEY=
# NADRA_CLIENT_ID=
# NADRA_MANDATORY=1

# MFA for admin roles (TOTP)
MFA_ENFORCE_ADMIN=1
MFA_ISSUER=DigiFyntek
