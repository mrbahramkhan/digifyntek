NODE_ENV=development
PORT=4000

# MySQL — database name
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digifyntek

# Use real Digital Kisaan tables (tbl_farmer, tbl_users, ...)
# After import:  CREATE DATABASE digifyntek; then import dump, or:
#   mysqldump ... | sed 's/digitalkisaan/digifyntek/g' | mysql
# DB_MODE=legacy

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES=8h
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,https://mrbahramkhan.github.io
TRUST_PROXY=0
