NODE_ENV=production
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=forge
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=forge_coop

# Auth — MUST change in production (min 32 chars)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_64_CHARS_MINIMUM_PLEASE
JWT_EXPIRES=8h

# CORS — comma-separated origins (no * in production)
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_MAX=10

# Optional: trust proxy behind nginx
TRUST_PROXY=1

# Legacy Digital Kisaan DB mode (uses tbl_farmer, tbl_users, tbl_loanaccount, ...)
# DB_NAME=digitalkisaan
# DB_MODE=legacy
